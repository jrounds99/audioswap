<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\audioswap.ico</ApplicationIcon>
    <AssemblyName>AudioSwap</AssemblyName>
    <RootNamespace>AudioSwap</RootNamespace>
    <Version>1.1.1</Version>
    <Product>AudioSwap</Product>
    <Description>Hotkeys for switching Windows audio input and output devices.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- All UI is built in code; designer serialization hints don't apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\audioswap.ico" LogicalName="AudioSwap.ico" />
  </ItemGroup>

</Project>
